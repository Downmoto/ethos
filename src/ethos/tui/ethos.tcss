Screen {
    layout: vertical;
}

#adaptive-shell {
    height: 1fr;
}

#app-header {
    height: 3;
    padding: 1 2;
    background: $primary;
    color: $text;
    text-style: bold;
}

#body {
    height: 1fr;
}

#navigation {
    width: 36;
    border-right: solid $primary-background;
}

.section-title {
    height: 1;
    margin: 1 1 0 1;
    text-style: bold;
}

#workspaces {
    height: 1fr;
    min-height: 5;
}

#sessions {
    height: 2fr;
    min-height: 7;
}

#main-pane {
    width: 1fr;
}

#conversation {
    height: 1fr;
    padding: 1 2;
}

.message {
    margin-bottom: 1;
    padding: 0 1;
}

.user {
    border-left: thick $accent;
}

.assistant {
    border-left: thick $success;
}

.conversation-empty {
    color: $text-muted;
    padding: 2;
}

PromptComposer {
    height: 8;
    border-top: solid $primary-background;
}

#prompt {
    height: 1fr;
    border: none;
}

#composer-hint {
    height: 1;
    padding: 0 2;
    color: $text-muted;
    text-align: right;
}

#feedback {
    height: 1;
    padding: 0 1;
    background: $surface;
    color: $text-muted;
}

#feedback.error {
    color: $error;
}

#shortcut-help,
#archive-confirmation {
    width: 48;
    height: auto;
    padding: 2 3;
    border: solid $primary;
    background: $surface;
}

_ShortcutHelp,
_ArchiveConfirmation {
    align: center middle;
    background: $background 70%;
}

.compact #navigation {
    width: 28;
}

.compact.main-mode #navigation {
    display: none;
}

.narrow #body {
    layout: vertical;
}

.narrow #navigation {
    display: none;
    width: 1fr;
    height: 1fr;
    border-right: none;
}

.narrow.navigation-mode #navigation {
    display: block;
}

.narrow.navigation-mode #main-pane {
    display: none;
}
